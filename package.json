{
  "name": "infinite-react-marquee",
  "version": "1.0.5",
  "description": "GPU-accelerated, zero-dependency infinite scrolling marquee component for React.",
  "type": "module",
  "license": "MIT",
  "author": "galbenyosef",
  "homepage": "https://galbenyosef.github.io/infinite-react-marquee/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galbenyosef/infinite-react-marquee.git"
  },
  "bugs": {
    "url": "https://github.com/galbenyosef/infinite-react-marquee/issues"
  },
  "keywords": [
    "react",
    "marquee",
    "infinite-scroll",
    "ticker",
    "carousel",
    "gpu-accelerated",
    "rtl",
    "accessible"
  ],
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs"
    }
  },
  "files": [
    "dist-lib",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:demo": "vite build",
    "build:lib": "vite build -c vite.config.lib.ts",
    "prepublishOnly": "npm run build:lib && npm test",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
}
